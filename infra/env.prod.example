# ---------------------------------------------------------------------------
# Nahubet: production compose environment (infra/docker-compose.prod.yml).
#
#   cp infra/env.prod.example infra/.env.prod      # .env.* files are git-ignored
#   $EDITOR infra/.env.prod                        # replace every CHANGE_ME
#   docker compose --env-file infra/.env.prod -f infra/docker-compose.prod.yml build
#   docker compose --env-file infra/.env.prod -f infra/docker-compose.prod.yml up -d
#
# Derived from .env.example; docs/deployment.md has the reference for every variable.
# Generate secrets with:  openssl rand -hex 32   (use hex: the values go into URLs)
#
# This template runs REAL MONEY (OPERATING_MODE=licensed). Set OPERATING_MODE=demo for a play-money trial. Licensed mode
# refuses to start only with the mock payment provider; everything else (SMS rail setup, https URLs, tax) is a
# startup WARNING, so read the log and work through the checklist in docs/deployment.md (section 4).
# With NODE_ENV=production even a demo deployment needs unique secrets and https public URLs
# (http://localhost is the one exception, for a local trial), and it has no dev OTP inbox.
# ---------------------------------------------------------------------------
NODE_ENV=production
OPERATING_MODE=licensed
LOG_LEVEL=info

# Public URLs (https in production). The browser bundles of web and admin carry PUBLIC_API_URL
# from BUILD time: after changing it, rebuild the web and admin images.
# ADMIN_WEB_URL must be a different origin from PUBLIC_WEB_URL.
PUBLIC_WEB_URL=http://localhost:3000
ADMIN_WEB_URL=http://localhost:3001
PUBLIC_API_URL=http://localhost:4000
# For the nahubet.com domain (docs/deployment.md, "The nahubet.com domain"):
#   PUBLIC_WEB_URL=https://nahubet.com
#   ADMIN_WEB_URL=https://admin.nahubet.com
#   PUBLIC_API_URL=https://api.nahubet.com
# Leave the variables below COMMENTED OUT unless you set them: an empty value is refused
# (they are URLs / names, not secrets). Unset = not configured.
# PAYMENT_CALLBACK_BASE_URL=https://api.nahubet.com

# Host ports (published on this address only; use 0.0.0.0 to expose them directly, or leave
# 127.0.0.1 and put the reverse proxy profile or your own load balancer in front).
BIND_ADDRESS=127.0.0.1
API_PORT=4000
# Only with the scale-out overlay (infra/docker-compose.scale.yml, docs/deployment.md "Scaling out the
# API"): API processes, connections each keeps to PgBouncer, and PgBouncer's pool towards Postgres.
# API_REPLICAS=3
# API_DB_POOL_MAX=20
# PGB_POOL_SIZE=40
# PGB_MAX_CLIENT_CONN=3000
# Only with the streams overlay (infra/docker-compose.streams.yml, docs/deployment.md "Live streams on
# their own processes"): stream processes and the connections each keeps to Postgres.
# API_STREAMS_REPLICAS=2
# API_STREAMS_DB_POOL_MAX=5
WEB_PORT=3000
ADMIN_PORT=3001
WORKER_HEALTH_PORT=4100
# Docker network of the stack; TRUST_PROXY must cover the reverse proxy's address in it.
VAMOS_SUBNET=172.30.77.0/24
# Whose X-Forwarded-For sets the client IP (rate limits, audit log): the proxy addresses/CIDRs.
# Empty = nobody (right when clients reach the API directly). With the bundled proxy profile:
# TRUST_PROXY=172.30.77.0/24
TRUST_PROXY=

# Reverse proxy profile (docker compose --profile proxy): Caddy with automatic TLS.
# WEB_DOMAIN=nahubet.com
# API_DOMAIN=api.nahubet.com
# ADMIN_DOMAIN=admin.nahubet.com
# ACME_EMAIL=ops@nahubet.com
# Who may reach the back office: the admin host AND the staff API (/admin* on the api host).
# Space-separated IPs/CIDRs (office, VPN). Unset: anywhere.
# STAFF_ALLOWLIST=203.0.113.0/24 198.51.100.7

# Data stores. The compose file builds DATABASE_URL and REDIS_URL from these passwords.
# POSTGRES_USER owns the database: only the one-shot migrate job (and seed / admin CLI runs of
# it) connect with it. The api and worker connect as the restricted role vamos_app (created by
# the migrations; it cannot rewrite the ledger or the audit log), whose password the migrate job
# sets from APP_DB_PASSWORD. Upgrading an older deployment: add APP_DB_PASSWORD
# (openssl rand -hex 16) before `docker compose up`.
POSTGRES_USER=vamos
POSTGRES_DB=vamos
POSTGRES_PASSWORD=CHANGE_ME
APP_DB_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
QUEUE_PREFIX=vamos

# Secrets. Unique per deployment; never reuse the development values.
# SESSION_SECRET: at least 32 characters (keys OTP and national-ID hashes: rotating it invalidates
# every session and OTP in flight). ADMIN_TOTP_KEY: 32 bytes as 64 hex characters (encrypts the
# staff TOTP secrets: losing or changing it locks every staff account out, see
# docs/runbooks/rotating-secrets.md). PASSWORD_PEPPER: at least 32 characters, the secret key of every
# player and staff password hash (argon2 secret): losing it makes every password unusable.
SESSION_SECRET=CHANGE_ME
ADMIN_TOTP_KEY=CHANGE_ME
PASSWORD_PEPPER=CHANGE_ME
MOCK_PAYMENT_WEBHOOK_SECRET=CHANGE_ME

# Odds feed: "mock" (simulated pricing + live simulator, demo only) or "manual" (traders only).
FEED_PROVIDER=manual
SIM_SPEED=1
FEED_ROLLING_EVERY_MINUTES=5
FEED_ROLLING_HORIZON_MINUTES=120

# Providers. Demo mode allows PAYMENT_PROVIDERS=mock and the simulated sms rail.
PAYMENT_PROVIDERS=chapa,telebirr,sms
# `mock` is the only KYC adapter (ID checks are simulated); the setting accepts nothing else.
KYC_PROVIDER=mock
# `mock` is the only SMS adapter (`http` has no adapter yet: the api and worker refuse to start with it).
# With it no code can be delivered, so registration runs without one: the phone number is then NOT proven to be
# the player's, and password-reset and payout-account codes cannot be used. `required` sends the code.
SMS_PROVIDER=mock
REGISTRATION_SMS_VERIFICATION=off

# Alerts to the owner's phone (plan task 1.11, docs/scraper.md 6.3a): a short SMS that says what an automatic
# safeguard did, a few a week. Sent through SMS_PROVIDER, so they need a real SMS adapter to reach a phone.
# Off while the list is empty.
# OWNER_ALERT_PHONES=                          # comma-separated E.164 numbers, at most 10: +251911234567
# OWNER_ALERT_MIN_INTERVAL_MINUTES=30          # 1..1440: the same alert is sent at most once per interval

# Payment providers (licensed mode only). Left empty here = not configured.
CHAPA_BASE_URL=https://api.chapa.co/v1
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=
# TELEBIRR_BASE_URL=
# TELEBIRR_CHECKOUT_URL=
TELEBIRR_FABRIC_APP_ID=
TELEBIRR_APP_SECRET=
TELEBIRR_MERCHANT_APP_ID=
TELEBIRR_SHORT_CODE=
TELEBIRR_PRIVATE_KEY=
TELEBIRR_PUBLIC_KEY=

# SMS deposit rail (PAYMENT_PROVIDERS=...,sms; see docs/runbooks/sms-rail.md). Demo mode runs it simulated
# with demo collection accounts. Licensed mode requires all of the following.
SMS_RAIL_MODE=live
# Its own secret, 32+ chars; the collection handset's forwarder sends it as x-gateway-secret.
SMS_GATEWAY_SECRET=CHANGE_ME
# Exact client addresses allowed to post SMS (empty: any address, the secret still applies).
SMS_GATEWAY_ALLOWLIST=
# JSON: [{"institution":"telebirr","account":"09...","name":"<OPERATOR_LEGAL_NAME>"},{"institution":"cbe",...}]
# SMS_COLLECTION_ACCOUNTS=
# OPERATOR_LEGAL_NAME=
RECEIPT_VERIFY=audit
RECEIPT_VERIFY_TIMEOUT_MS=6000
SMS_HEARTBEAT_ALARM_MINUTES=20
PAYOUT_REQUIRE_PROOF=true
PAYOUT_PROOF_WAIVED=false

TAX_CONFIG_CONFIRMED=false

# Product feature flags (casino/virtuals are excluded by policy).
FEATURE_CASINO=false
FEATURE_FACTORY_MARKETS=false
FEATURE_VIRTUALS=false

# SMS and USSD betting: keep off until the regulator approves the channel.
SMS_BETTING_ENABLED=false
USSD_ENABLED=false
SMS_AGGREGATOR=mock
SMS_WEBHOOK_SECRET=CHANGE_ME
SMS_SHORT_CODE=8123
USSD_AGGREGATOR=mock
USSD_SHARED_SECRET=CHANGE_ME
USSD_SERVICE_CODE=*123#

# Observability. Traces are exported (OTLP over HTTP) only when the endpoint is set.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=

# Image tag of all services, and the back-office banner of the admin build ("licensed" hides it).
VAMOS_VERSION=local
NEXT_PUBLIC_OPERATING_MODE=licensed

# Scraper (docs/scraper.md section 7). The `scraper` compose service always runs with
# FEED_PROVIDER=scraped; set FEED_PROVIDER=scraped above as well to make the api and worker read
# its catalogue. Commented out = defaults. In licensed mode with FEED_PROVIDER=scraped a contact is
# required and robots must be enforced. API keys of sources are the SCRAPER_SECRET_* variables at
# the end of this block (secrets: keep this file private). The raw snapshot archive is the
# `scraper_archive` volume at /var/lib/vamos/scraper (fixed in the compose file; backed up by
# backup.sh, docs/backups.md).
# SCRAPER_USER_AGENT=NahubetBot/1.0              # identifies us to sources
# REQUIRED when OPERATING_MODE=licensed and FEED_PROVIDER=scraped: a URL or email that sources can
# reach us at, appended to the user agent.
# SCRAPER_CONTACT=ops@example.com
# SCRAPER_ROBOTS=enforce                       # enforce | off; off is refused in licensed mode
# SCRAPER_MAX_CONCURRENCY=4                    # hosts fetched in parallel
# SCRAPER_RESULT_CONFIRM_MINUTES=15            # an agreed result must stay unchanged this long (minimum 5)
# SCRAPER_MIN_RATING_MATCHES=8                 # matches a team needs before its odds come from ratings (minimum 1)
# Feed-quality switches (docs/scraper-operations.md). Recommended for the 100K Odds API plan without a paid
# results API (docs/feed-quality-plan.md, "Budget"): SCRAPER_HALF_TIME_MARKETS=covered, the rest as below.
# SCRAPER_HALF_TIME_MARKETS=all                # all | covered: half-time markets only where a source gives half time (O6)
# SCRAPER_AUTO_ALIAS=off                       # off | on: map strong fixture-context suggestions per source (N4)
# SCRAPER_PRIORITY_COMPETITIONS=               # C-2: slugs on the fast odds schedule; unset = every competition
# SCRAPER_SKIP_REDUNDANT_SCORES=off            # off | on: C-2, skip a scores read two other upstreams cover
# SCRAPER_CAP_AT_BEST_PRICE=off                # off | on: cap prices at the best book price (O7); off still flags
# SCRAPER_PRICE_EXPIRY_MINUTES=0               # 0..1440: P7, minutes a scraped price stays bettable unrefreshed; 0 = off
# SCRAPER_FACTORY_MARKETS=off                 # off | on: plan 2.3, price the factory's markets (hidden until FEATURE_FACTORY_MARKETS)
# API key of a source that authenticates with a request header (docs/scraper-operations.md section 7).
# The source config names this variable (auth.secret); it is passed to the scraper service only.
# Another key needs its own SCRAPER_SECRET_<NAME> line here and in docker-compose.prod.yml.
# SCRAPER_SECRET_API_FOOTBALL=
# football-data.org (docs/scraper-plan/data/source-footballdata-en1.json): the free plan's token.
# SCRAPER_SECRET_FOOTBALL_DATA=
# The Odds API (docs/theoddsapi-plan/README.md): bookmaker prices for the market-priced leagues.
# SCRAPER_SECRET_THEODDSAPI=
# PLAYER_SESSION_HOURS=8760                   # how long a player stays signed in (default a year); 12 = the strict limit
# PLAYER_SESSION_IDLE_MINUTES=0               # 0 = no idle limit; 30 = the strict limit
