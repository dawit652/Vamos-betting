# ---------------------------------------------------------------------------
# Vamos Betting: production compose environment (infra/docker-compose.prod.yml).
#
#   cp infra/env.prod.example infra/.env.prod      # .env.* files are git-ignored
#   $EDITOR infra/.env.prod                        # replace every CHANGE_ME
#   docker compose --env-file infra/.env.prod -f infra/docker-compose.prod.yml build
#   docker compose --env-file infra/.env.prod -f infra/docker-compose.prod.yml up -d
#
# Derived from .env.example; docs/deployment.md has the reference for every variable.
# Generate secrets with:  openssl rand -hex 32   (use hex: the values go into URLs)
#
# OPERATING_MODE=demo (default) is play money with mock providers. OPERATING_MODE=licensed is
# REFUSED at startup unless every licensed-mode prerequisite holds (see docs/deployment.md).
# With NODE_ENV=production even a demo deployment needs unique secrets and https public URLs
# (http://localhost is the one exception, for a local trial), and it has no dev OTP inbox.
# ---------------------------------------------------------------------------
NODE_ENV=production
OPERATING_MODE=demo
LOG_LEVEL=info

# Public URLs (https in production). The browser bundles of web and admin carry PUBLIC_API_URL
# from BUILD time: after changing it, rebuild the web and admin images.
# ADMIN_WEB_URL must be a different origin from PUBLIC_WEB_URL.
PUBLIC_WEB_URL=http://localhost:3000
ADMIN_WEB_URL=http://localhost:3001
PUBLIC_API_URL=http://localhost:4000
# Leave the variables below COMMENTED OUT unless you set them: an empty value is refused
# (they are URLs / names, not secrets). Unset = not configured.
# PAYMENT_CALLBACK_BASE_URL=https://api.example.et

# Host ports (published on this address only; use 0.0.0.0 to expose them directly, or leave
# 127.0.0.1 and put the reverse proxy profile or your own load balancer in front).
BIND_ADDRESS=127.0.0.1
API_PORT=4000
WEB_PORT=3000
ADMIN_PORT=3001
WORKER_HEALTH_PORT=4100
# Docker network of the stack; TRUST_PROXY must cover the reverse proxy's address in it.
VAMOS_SUBNET=172.30.77.0/24
# Whose X-Forwarded-For sets the client IP (rate limits, audit log): the proxy addresses/CIDRs.
# Empty = nobody (right when clients reach the API directly). With the bundled proxy profile:
# TRUST_PROXY=172.30.77.0/24
TRUST_PROXY=

# Reverse proxy profile (docker compose --profile proxy): Caddy with automatic TLS.
# WEB_DOMAIN=www.example.et
# API_DOMAIN=api.example.et
# ADMIN_DOMAIN=admin.example.et
# ACME_EMAIL=ops@example.et
# Who may reach the back office: the admin host AND the staff API (/admin* on the api host).
# Space-separated IPs/CIDRs (office, VPN). Unset: anywhere.
# STAFF_ALLOWLIST=203.0.113.0/24 198.51.100.7

# Data stores. The compose file builds DATABASE_URL and REDIS_URL from these passwords.
# POSTGRES_USER owns the database: only the one-shot migrate job (and seed / admin CLI runs of
# it) connect with it. The api and worker connect as the restricted role vamos_app (created by
# the migrations; it cannot rewrite the ledger or the audit log), whose password the migrate job
# sets from APP_DB_PASSWORD. Upgrading an older deployment: add APP_DB_PASSWORD
# (openssl rand -hex 16) before `docker compose up`.
POSTGRES_USER=vamos
POSTGRES_DB=vamos
POSTGRES_PASSWORD=CHANGE_ME
APP_DB_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
QUEUE_PREFIX=vamos

# Secrets. Unique per deployment; never reuse the development values.
# SESSION_SECRET: at least 32 characters (keys OTP and national-ID hashes: rotating it invalidates
# every session and OTP in flight). ADMIN_TOTP_KEY: 32 bytes as 64 hex characters (encrypts the
# staff TOTP secrets: losing or changing it locks every staff account out, see
# docs/runbooks/rotating-secrets.md). PASSWORD_PEPPER: at least 32 characters, the secret key of every
# player and staff password hash (argon2 secret): losing it makes every password unusable.
SESSION_SECRET=CHANGE_ME
ADMIN_TOTP_KEY=CHANGE_ME
PASSWORD_PEPPER=CHANGE_ME
MOCK_PAYMENT_WEBHOOK_SECRET=CHANGE_ME

# Odds feed: "mock" (simulated pricing + live simulator, demo only) or "manual" (traders only).
FEED_PROVIDER=mock
SIM_SPEED=1
FEED_ROLLING_EVERY_MINUTES=5
FEED_ROLLING_HORIZON_MINUTES=120

# Providers. Demo mode only allows PAYMENT_PROVIDERS=mock.
PAYMENT_PROVIDERS=mock
KYC_PROVIDER=mock
SMS_PROVIDER=mock

# Payment providers (licensed mode only). Left empty here = not configured.
CHAPA_BASE_URL=https://api.chapa.co/v1
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=
# TELEBIRR_BASE_URL=
# TELEBIRR_CHECKOUT_URL=
TELEBIRR_FABRIC_APP_ID=
TELEBIRR_APP_SECRET=
TELEBIRR_MERCHANT_APP_ID=
TELEBIRR_SHORT_CODE=
TELEBIRR_PRIVATE_KEY=
TELEBIRR_PUBLIC_KEY=

TAX_CONFIG_CONFIRMED=false

# Product feature flags (casino/virtuals are excluded by policy).
FEATURE_CASINO=false
FEATURE_VIRTUALS=false

# SMS and USSD betting: keep off until the regulator approves the channel.
SMS_BETTING_ENABLED=false
USSD_ENABLED=false
SMS_AGGREGATOR=mock
SMS_WEBHOOK_SECRET=CHANGE_ME
SMS_SHORT_CODE=8123
USSD_AGGREGATOR=mock
USSD_SHARED_SECRET=CHANGE_ME
USSD_SERVICE_CODE=*123#

# Observability. Traces are exported (OTLP over HTTP) only when the endpoint is set.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=

# Image tag of all services, and the back-office banner of the admin build ("licensed" hides it).
VAMOS_VERSION=local
NEXT_PUBLIC_OPERATING_MODE=demo
