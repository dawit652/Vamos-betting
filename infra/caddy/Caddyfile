# Reverse proxy of the production compose stack (profile "proxy"): Caddy terminates TLS with
# automatic certificates (Let's Encrypt / ZeroSSL; needs the three domains to resolve to this host
# and ports 80/443 reachable). Replace it with your own load balancer if the host provider has one;
# then keep the upstream ports and set TRUST_PROXY to the balancer's addresses.
{
	email {$ACME_EMAIL}
}

(common) {
	encode zstd gzip
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
	}
}

{$WEB_DOMAIN} {
	import common
	# server.mjs already compresses (brotli) and sets cache headers.
	reverse_proxy web:3000 {
		header_up X-Forwarded-Proto {scheme}
	}
}

{$API_DOMAIN} {
	import common
	# The staff API (/admin/*) is reachable only from STAFF_ALLOWLIST (space-separated IPs/CIDRs of
	# the office or VPN; default: anywhere). Restricting the admin host alone would not restrict
	# it: the back office calls this host from the staff member's browser.
	@staff_denied {
		path /admin /admin/*
		not remote_ip {$STAFF_ALLOWLIST:0.0.0.0/0 ::/0}
	}
	respond @staff_denied "Forbidden" 403
	# SSE (/live/stream, /me/stream): flush every write instead of buffering.
	reverse_proxy api:4000 {
		flush_interval -1
		header_up X-Forwarded-Proto {scheme}
	}
}

{$ADMIN_DOMAIN} {
	import common
	# The back-office pages: the same allowlist as the staff API.
	@denied not remote_ip {$STAFF_ALLOWLIST:0.0.0.0/0 ::/0}
	respond @denied "Forbidden" 403
	reverse_proxy admin:3001 {
		header_up X-Forwarded-Proto {scheme}
	}
}
