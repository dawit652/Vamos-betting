# ---------------------------------------------------------------------------
# Vamos Betting: LICENSED-mode production environment (infra/docker-compose.prod.yml).
#
#   cp infra/env.licensed.example infra/.env.licensed   # .env.* files are git-ignored
#   $EDITOR infra/.env.licensed                          # replace every CHANGE_ME / fill every blank
#   docker compose --env-file infra/.env.licensed -f infra/docker-compose.prod.yml build
#   docker compose --env-file infra/.env.licensed -f infra/docker-compose.prod.yml up -d
#
# Real money. The api and worker REFUSE to start (licensedModeViolations in
# packages/config/src/config.ts) until every item below is satisfied, and the database must be a
# fresh one that was never used in demo mode (it is marked licensed on first start and can never
# change). Do not set OPERATING_MODE=licensed without an Ethiopian Lottery Service (ELS) licence.
# Checklist: docs/deployment.md section 4. Keep this file out of git and in a secret manager.
# Generate secrets with:  openssl rand -hex 32
# ---------------------------------------------------------------------------
NODE_ENV=production
OPERATING_MODE=licensed
LOG_LEVEL=info

# Public URLs: https only; the admin origin must differ from the web origin.
# The browser bundles carry PUBLIC_API_URL from BUILD time: rebuild web and admin after changing it.
PUBLIC_WEB_URL=https://CHANGE_ME_WEB_DOMAIN
ADMIN_WEB_URL=https://CHANGE_ME_ADMIN_DOMAIN
PUBLIC_API_URL=https://CHANGE_ME_API_DOMAIN
# PAYMENT_CALLBACK_BASE_URL=https://CHANGE_ME_API_DOMAIN   # optional; https when set

BIND_ADDRESS=127.0.0.1
API_PORT=4000
WEB_PORT=3000
ADMIN_PORT=3001
WORKER_HEALTH_PORT=4100
VAMOS_SUBNET=172.30.77.0/24
# With the bundled Caddy proxy profile: TRUST_PROXY=172.30.77.0/24
TRUST_PROXY=

# WEB_DOMAIN=CHANGE_ME_WEB_DOMAIN
# API_DOMAIN=CHANGE_ME_API_DOMAIN
# ADMIN_DOMAIN=CHANGE_ME_ADMIN_DOMAIN
# ACME_EMAIL=CHANGE_ME
# Back office reachable only from the office / VPN (admin host AND /admin* on the api host).
# STAFF_ALLOWLIST=203.0.113.0/24

# Data stores.
POSTGRES_USER=vamos
POSTGRES_DB=vamos
POSTGRES_PASSWORD=CHANGE_ME
APP_DB_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
QUEUE_PREFIX=vamos

# Secrets: unique, never the development values; SESSION_SECRET and PASSWORD_PEPPER must differ.
# ADMIN_TOTP_KEY is 32 bytes as 64 hex characters. See docs/runbooks/rotating-secrets.md.
SESSION_SECRET=CHANGE_ME
ADMIN_TOTP_KEY=CHANGE_ME
PASSWORD_PEPPER=CHANGE_ME

# Odds feed: "mock" is refused in licensed mode. "manual" = traders price markets in the back office.
FEED_PROVIDER=manual

# Providers: no "mock" anywhere. Payments: chapa and/or telebirr, each with its credentials.
PAYMENT_PROVIDERS=chapa
KYC_PROVIDER=fayda
SMS_PROVIDER=http

# Chapa (https only). CHAPA_WEBHOOK_SECRET: at least 32 characters.
CHAPA_BASE_URL=https://api.chapa.co/v1
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=
# telebirr (add "telebirr" to PAYMENT_PROVIDERS and fill all of these; https only)
# TELEBIRR_BASE_URL=
# TELEBIRR_CHECKOUT_URL=
TELEBIRR_FABRIC_APP_ID=
TELEBIRR_APP_SECRET=
TELEBIRR_MERCHANT_APP_ID=
TELEBIRR_SHORT_CODE=
TELEBIRR_PRIVATE_KEY=
TELEBIRR_PUBLIC_KEY=

# Ethiopian Lottery Service. The licence number is REQUIRED and must be the one ELS issued to you;
# the stack does not start without it. Reports go to files on the backed-up `els` volume
# (/var/lib/vamos/els, fixed in the compose file; kept 7 years). "off" and "http" are refused.
ELS_LICENSE_NUMBER=
ELS_REPORTING_MODE=file
# Set to true ONLY after counsel confirmed the winnings-tax rate, base and exemption.
TAX_CONFIG_CONFIRMED=false

# Not licensable.
FEATURE_CASINO=false
FEATURE_VIRTUALS=false

# SMS and USSD betting stay off until the regulator approves the channel and a real aggregator is
# contracted (the mock aggregators are refused while a channel is on).
SMS_BETTING_ENABLED=false
USSD_ENABLED=false

# Observability.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=

VAMOS_VERSION=local
NEXT_PUBLIC_OPERATING_MODE=licensed
