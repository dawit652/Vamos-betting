# ---------------------------------------------------------------------------
# Nahubet configuration. Copy to .env and adjust.
#
# OPERATING_MODE=demo (default) runs on play money with mock providers only.
# OPERATING_MODE=licensed is REFUSED at startup unless every compliance
# prerequisite below is configured.
# ---------------------------------------------------------------------------
NODE_ENV=development
OPERATING_MODE=demo
LOG_LEVEL=info

API_HOST=0.0.0.0
API_PORT=4000
PUBLIC_API_URL=http://localhost:4000
PUBLIC_WEB_URL=http://localhost:3000
ADMIN_WEB_URL=http://localhost:3001

# Native Postgres (pnpm services:start) listens on 5432. The Docker file (infra/docker-compose.yml)
# publishes it on 5433: with Docker use postgres://vamos:vamos@localhost:5433/vamos
DATABASE_URL=postgres://vamos:vamos@localhost:5432/vamos
REDIS_URL=redis://localhost:6379
# Key prefix of the worker's BullMQ queues (settlement, live bet acceptance).
QUEUE_PREFIX=vamos
# At least 32 characters. Must be unique in production.
SESSION_SECRET=dev-only-session-secret-change-me-0123456789
# The secret key (argon2 "pepper") of every password hash, kept outside the database: 32+ characters,
# e.g. `openssl rand -hex 32`. Required in production and licensed mode; unset here (no pepper).
# PASSWORD_PEPPER=
# Encrypts the back-office staff TOTP secrets (AES-256-GCM): 32 random bytes as 64 hex
# characters or base64, e.g. `openssl rand -hex 32`. The value below is the public
# development key: production and licensed mode refuse it.
ADMIN_TOTP_KEY=aed9c3710ea4fb29e5d03551229bacfb328e796012897a735bda51c7d3432e4e
# Proxies whose X-Forwarded-For may set the client IP (rate limits, audit log):
# comma-separated addresses/CIDRs, e.g. 10.0.0.0/8. Empty = trust no proxy. `true` is refused.
TRUST_PROXY=
# In production, PUBLIC_WEB_URL, ADMIN_WEB_URL and PUBLIC_API_URL must be https (http is allowed
# only on localhost): they are the CORS origins and the session cookies are Secure.

# Worker health server: GET /health (process up) and /ready (database, Redis, queues). 0 = off.
WORKER_HEALTH_PORT=4100
WORKER_HEALTH_HOST=0.0.0.0
# OpenTelemetry traces (OTLP over HTTP, e.g. http://otel-collector:4318). Unset = tracing off.
OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=vamos-api

# Odds feed: "mock" (simulated Poisson pricing + live simulator) or "manual" (traders only).
FEED_PROVIDER=mock
# Simulated match minutes per real second for the live simulator (1 = 90 s matches).
SIM_SPEED=1
# Rolling demo fixtures: one kicks off every N minutes (whole minutes >= 1), generated up to the
# horizon ahead. e2e uses 1 and 10 (with SIM_SPEED=60) so a bet settles within a few minutes.
FEED_ROLLING_EVERY_MINUTES=5
FEED_ROLLING_HORIZON_MINUTES=120

# Providers. Demo mode allows PAYMENT_PROVIDERS=mock and the simulated sms rail (mock,sms).
PAYMENT_PROVIDERS=mock
KYC_PROVIDER=mock
SMS_PROVIDER=mock

# Payments. Provider webhooks call PAYMENT_CALLBACK_BASE_URL (default PUBLIC_API_URL); redirect
# checkouts return the player to PUBLIC_WEB_URL. Real providers can only be enabled in licensed
# mode; their credentials are checked when the provider is built at startup.
# PAYMENT_CALLBACK_BASE_URL=https://api.example.et
# HMAC key of the mock provider's webhooks (dev phone simulator). Must be changed in production.
MOCK_PAYMENT_WEBHOOK_SECRET=dev-only-mock-payment-webhook-secret-0123456789
# Chapa (https://developer.chapa.co): secret key and the webhook secret from the dashboard
# (set a random webhook secret of at least 32 characters there; shorter ones are refused).
CHAPA_BASE_URL=https://api.chapa.co/v1
# CHAPA_SECRET_KEY=
# CHAPA_WEBHOOK_SECRET=
# telebirr H5 web payment (Fabric API). Keys are PEM; "\n" in the value is read as a newline.
# TELEBIRR_BASE_URL=
# TELEBIRR_CHECKOUT_URL=
# TELEBIRR_FABRIC_APP_ID=
# TELEBIRR_APP_SECRET=
# TELEBIRR_MERCHANT_APP_ID=
# TELEBIRR_SHORT_CODE=
# TELEBIRR_PRIVATE_KEY=
# TELEBIRR_PUBLIC_KEY=

# SMS deposit rail (provider "sms", docs/runbooks/sms-rail.md). simulated = demo collection accounts and
# the dev SMS simulator; live = licensed mode only, with all of the variables below.
SMS_RAIL_MODE=simulated
# SMS_GATEWAY_SECRET=
# SMS_GATEWAY_ALLOWLIST=
# SMS_COLLECTION_ACCOUNTS=[{"institution":"telebirr","account":"09...","name":"<OPERATOR_LEGAL_NAME>"}]
# OPERATOR_LEGAL_NAME=
RECEIPT_VERIFY=audit
# RECEIPT_VERIFY_TIMEOUT_MS=6000
# PAYOUT_REQUIRE_PROOF=false
# PAYOUT_PROOF_WAIVED=false

# Set to true only after the winnings-tax rate/base/exemption are confirmed with counsel.
TAX_CONFIG_CONFIRMED=false

# Product feature flags (casino/virtuals are excluded by policy).
FEATURE_CASINO=false
FEATURE_VIRTUALS=false

# SMS and USSD betting (Phase 11). Keep both off until the regulator approves the channel;
# while off, POST /channels/sms/inbound and POST /channels/ussd answer 404.
# (FEATURE_SMS_BETTING / FEATURE_USSD are still read as legacy spellings.)
SMS_BETTING_ENABLED=false
USSD_ENABLED=false
# Aggregators: only the demo "mock" exists until one is contracted. Production refuses the
# development secrets while a channel is on.
# SMS_AGGREGATOR=mock
# SMS_WEBHOOK_SECRET=
# SMS_SHORT_CODE=8123
# USSD_AGGREGATOR=mock
# USSD_SHARED_SECRET=
# USSD_SERVICE_CODE=*123#

# Scraper (docs/scraper.md section 7): match data from public sources, used with FEED_PROVIDER=scraped.
# Everything is optional; the defaults suit local development. Licensed mode with
# FEED_PROVIDER=scraped additionally requires an absolute SCRAPER_ARCHIVE_DIR, SCRAPER_CONTACT and
# SCRAPER_ROBOTS=enforce. How many independent sources a result needs is a code constant, not a setting.
# SCRAPER_ARCHIVE_DIR=./var/scraper      # raw snapshot store (evidence behind results); absolute in licensed mode
# SCRAPER_USER_AGENT=NahubetBot/1.0        # identifies us to sources
# SCRAPER_CONTACT=                       # URL or email appended to the user agent: "NahubetBot/1.0 (+contact)"
# SCRAPER_ROBOTS=enforce                 # enforce | off; off ignores robots.txt and is refused in licensed mode
# SCRAPER_PORT=4200                      # health server (0 = off)
# SCRAPER_MAX_CONCURRENCY=4              # hosts fetched in parallel
# SCRAPER_RESULT_CONFIRM_MINUTES=15      # an agreed result must stay unchanged this long (minimum 5)
# SCRAPER_MIN_RATING_MATCHES=8           # matches a team needs before its odds are priced from ratings (minimum 1)
# SCRAPER_HALF_TIME_MARKETS=all          # all | covered: half-time markets only where an enabled source gives half time (O6)
# SCRAPER_AUTO_ALIAS=off                # off | on: map a strong fixture-context suggestion as a source alias where two FT upstreams protect results (N4)
# SCRAPER_PRIORITY_COMPETITIONS=        # C-2: priority competition slugs (premier-league,la-liga); others' odds read 30 min/2 h/170 min. Unset: all priority
# SCRAPER_SKIP_REDUNDANT_SCORES=off     # off | on: C-2, do not read a scores source that would be a third full-time upstream
# SCRAPER_CAP_AT_BEST_PRICE=off          # off | on: cap our prices at the best fresh book price (O7); off still flags odds_out_of_line
# SCRAPER_HULUSPORT_URL=                 # the mr-x board of Hulusport prices, e.g. http://127.0.0.1:3100 (docs/plans/hulusport-feed.md); unset: not read
# SCRAPER_HULUSPORT_INTERVAL_SECONDS=120 # seconds between two reads of the mr-x board (30 to 3600)
# API key of a source that sends it in a request header; the source config names the variable
# (auth.secret, docs/scraper.md 6.7). Any SCRAPER_SECRET_<NAME> works; the value is never stored.
# SCRAPER_SECRET_API_FOOTBALL=
# SCRAPER_SECRET_FOOTBALL_DATA=
# The Odds API key (docs/theoddsapi-plan/README.md).
# SCRAPER_SECRET_THEODDSAPI=
