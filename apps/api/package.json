{
  "name": "@vamos/api",
  "version": "0.1.0",
  "private": true,
  "description": "Vamos REST + SSE API (Fastify)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "start": "node dist/server.js",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.1",
    "@node-rs/argon2": "2.2.2",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.11.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@vamos/config": "workspace:*",
    "@vamos/contracts": "workspace:*",
    "@vamos/core": "workspace:*",
    "@vamos/db": "workspace:*",
    "@vamos/payments": "workspace:*",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.7",
    "ioredis": "5.11.1",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "tsup": "8.5.1"
  }
}
