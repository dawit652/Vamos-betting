{
  "name": "@vamos/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Background workers: feed ingest, live simulator, settlement, payouts, notifications, reporting",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "start": "node dist/main.js",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@vamos/config": "workspace:*",
    "@vamos/core": "workspace:*",
    "@vamos/db": "workspace:*",
    "@vamos/feed": "workspace:*",
    "@vamos/payments": "workspace:*",
    "bullmq": "6.3.11",
    "drizzle-orm": "0.45.3",
    "ioredis": "5.11.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "tsup": "8.5.1"
  }
}
