{
  "name": "@vamos/scraper-app",
  "version": "0.1.0",
  "private": true,
  "description": "The scraper process: schedules source runs, stores observations and promotes checked data to the catalogue",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "start": "node dist/main.js",
    "cli": "tsx src/cli.ts",
    "seed:review": "tsx src/devtools/seed-review-queue.ts",
    "seed:result-demo": "tsx src/devtools/seed-result-demo.ts",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@vamos/config": "workspace:*",
    "@vamos/contracts": "workspace:*",
    "@vamos/core": "workspace:*",
    "@vamos/db": "workspace:*",
    "@vamos/feed": "workspace:*",
    "@vamos/scraper": "workspace:*",
    "drizzle-orm": "0.45.3",
    "ioredis": "5.11.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "tsup": "8.5.1"
  }
}
