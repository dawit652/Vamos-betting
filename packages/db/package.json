{
  "name": "@vamos/db",
  "version": "0.1.0",
  "private": true,
  "description": "Drizzle ORM schema, migrations and seed data (PostgreSQL 16)",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./testing": "./src/testing.ts",
    "./passwords": "./src/backoffice/argon2.ts",
    "./totp": "./src/backoffice/totp.ts",
    "./demo-staff": "./src/backoffice/demo-staff-accounts.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/scripts/migrate.ts",
    "seed": "tsx src/scripts/seed.ts",
    "admin:create": "tsx src/scripts/admin-create.ts",
    "admin:unlock": "tsx src/scripts/admin-unlock.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "@opentelemetry/api": "1.9.1",
    "@vamos/config": "workspace:*",
    "@vamos/core": "workspace:*",
    "drizzle-orm": "0.45.3",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "@vamos/payments": "workspace:*",
    "drizzle-kit": "0.31.11",
    "fast-check": "4.10.2"
  }
}
