{
  "name": "vamos-betting",
  "private": true,
  "description": "Vamos Betting \u2013 mobile-first sportsbook for the Ethiopian market (demo mode until licensed)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @vamos/api --filter @vamos/worker --filter @vamos/web dev",
    "dev:all": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r --if-present build",
    "lint": "node --max-old-space-size=4096 node_modules/eslint/bin/eslint.js . --max-warnings=0",
    "lint:fix": "node --max-old-space-size=4096 node_modules/eslint/bin/eslint.js . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:unit": "pnpm -r --if-present test:unit",
    "test:infra": "bash infra/scripts/backup.test.sh",
    "sbom": "node scripts/sbom.mjs",
    "audit:prod": "pnpm audit --prod",
    "e2e": "pnpm --filter @vamos/e2e e2e",
    "load:bets": "pnpm --filter @vamos/load bet-placement",
    "db:generate": "pnpm --filter @vamos/db generate",
    "db:migrate": "pnpm --filter @vamos/db migrate",
    "db:seed": "pnpm --filter @vamos/db seed",
    "admin:create": "pnpm --filter @vamos/db admin:create",
    "admin:unlock": "pnpm --filter @vamos/db admin:unlock",
    "admin:totp-rekey": "pnpm --filter @vamos/db admin:totp-rekey",
    "services:start": "bash infra/scripts/dev-services.sh start",
    "services:stop": "bash infra/scripts/dev-services.sh stop",
    "services:status": "bash infra/scripts/dev-services.sh status"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@node-rs/argon2",
      "esbuild",
      "sharp",
      "@swc/core",
      "@parcel/watcher",
      "unrs-resolver"
    ],
    "overrides": {
      "zod@<4.6.6": "4.6.7",
      "tsup>esbuild": "0.28.2",
      "@esbuild-kit/core-utils>esbuild": "0.25.12",
      "hyperid>uuid": "11.1.1"
    }
  }
}
